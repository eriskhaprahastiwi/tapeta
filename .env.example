# Buat project Supabase, lalu salin URL dan anon/publishable key dari dashboard.
# Jangan pernah menaruh service_role key di aplikasi browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opsional: provider tile produksi yang disetujui pengelola.
VITE_OSM_TILE_URL=

# Hanya server/CLI. Tidak dibaca Vite dan tidak boleh menggunakan awalan VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Akun moderator untuk scripts/import-destinations.mjs --push.
SUPABASE_IMPORT_EMAIL=
SUPABASE_IMPORT_PASSWORD=
